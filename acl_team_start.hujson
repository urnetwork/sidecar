// Team's starting document (D-ACL-2, D-ACL-23, R-ACL-3; owner decisions 74, 179, 180, 344; plan-ACL-team-grant1-src,
// route-rows-via-team-grant1-via): the first Owner's device saves it as the network's first document after
// team-create, so has_document holds from then on. A Team narrows any rule, gives one two approvers or removes it, as
// its own document.
{
  "tagOwners": { "tag:recurd": ["autogroup:member"] },
  "grants": [
    // §8.5's grant 1: a member's own devices and apps reach each other, and route through each other to the prefixes
    // their approved routes serve
    { "src": ["autogroup:member", "autogroup:untagged"], "dst": ["autogroup:self"], "via": ["autogroup:self"],
      "allow": ["dial", "route"] },
    // R-ACL-3's default: a recURd agent reaches its owner's or sponsor's devices on 443
    { "src": ["tag:recurd"], "dst": ["autogroup:self"], "allow": ["dial"], "ip": ["tcp:443"] },
    // +agent_repos
    // DESIGN-COMPUTE §16.5's deposit into agent repos (§20.4): members' devices and the agents on them deposit into
    // every agent repo, an agent's inbox, and read nothing there; a Team narrows it per agent, naming the agent repos
    // its members deposit into, and another tagged subject deposits only where a rule names it (Q-HARN-9)
    { "src": ["autogroup:member"], "dst": ["evs:kind:agent"], "allow": ["deposit"] },
    // -agent_repos
    // +compute_policy
    // DESIGN-COMPUTE §16.5's defaults: every member device and its agents run any remote model and search the web,
    // under the Team's budgets and floor; a Team narrows the models or turns search off with its own rules
    { "src": ["autogroup:member"], "dst": ["model:*"], "allow": ["infer"] },
    { "src": ["autogroup:member"], "dst": ["compute:search"], "allow": ["query"] },
    // -compute_policy
  ],
  "requests": [
    // the team directory's reach requests (§16.11), the implicit document's last rule
    { "src": ["autogroup:member", "autogroup:tagged"],
      "dst": ["autogroup:member", "autogroup:tagged", "sock:*"], "allow": ["dial"],
      "approver": ["autogroup:dst-owner"], "evidence": ["device", "presence"], "maxExpiry": "30d" },
  ],
  "tests": [
    // a member dials its own devices and routes through them, and dials no other member's device or tagged one
    { "src": "autogroup:member", "accept": ["autogroup:self#dial", "autogroup:self#route"],
      "deny": ["autogroup:member#dial", "autogroup:tagged#dial"] },
    { "src": "tag:recurd", "deny": ["autogroup:member#dial", "autogroup:tagged#dial"] },
  ],
}
