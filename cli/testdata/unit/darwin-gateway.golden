path: /home/synthetic/Library/LaunchAgents/network.ur.ur.work.plist
--- content
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>network.ur.ur.work</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/urnetwork/bin/ur</string>
		<string>daemon</string>
		<string>--instance</string>
		<string>work</string>
		<string>--unit</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Sockets</key>
	<dict>
		<key>gateway</key>
		<array>
			<dict>
				<key>SockFamily</key>
				<string>IPv4</string>
				<key>SockNodeName</key>
				<string>127.0.0.1</string>
				<key>SockServiceName</key>
				<string>21234</string>
				<key>SockType</key>
				<string>stream</string>
			</dict>
			<dict>
				<key>SockFamily</key>
				<string>IPv6</string>
				<key>SockNodeName</key>
				<string>::1</string>
				<key>SockServiceName</key>
				<string>21234</string>
				<key>SockType</key>
				<string>stream</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
--- install
launchctl bootout gui/501/network.ur.ur.work
launchctl bootstrap gui/501 /home/synthetic/Library/LaunchAgents/network.ur.ur.work.plist
--- uninstall
launchctl bootout gui/501/network.ur.ur.work
