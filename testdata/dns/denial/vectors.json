{
 "comment": "Signed answers and compact denial (RFC 9824). Rows read as in testdata/dns/answers. Each case is asked over UDP at EDNS 1232, with DO unless do is false and CO when co is true. answer and authority list the records other than RRSIGs as miekg prints them; rrsigs lists each RRSIG as '<owner> <type covered> <labels>' in the order it appears. dnskey cases answer the test window's RRset, which the test reads from its keys. Every RRSIG is verified with miekg's RRSIG.Verify against the test ZSK, and the DNSKEY RRset's against the test KSK.",
 "root": "zone.example.",
 "serial": 100,
 "rows": [
  "zone.example. 3600 system SOA ns1.zone.example. hostmaster.zone.example. 1 7200 3600 1209600 300",
  "zone.example. 86400 system NS ns1.zone.example.",
  "zone.example. 86400 system NS ns2.zone.example.",
  "zone.example. 3600 system TXT \"v=spf1 -all\"",
  "zone.example. 60 edge A",
  "zone.example. 60 edge AAAA",
  "ns1.zone.example. 86400 system A 192.0.2.1",
  "ns2.zone.example. 86400 system A 192.0.2.2",
  "net1.zone.example. 300 system MX 0 .",
  "net1.zone.example. 60 edge A",
  "*.net1.zone.example. 300 system MX 10 mx.net1.zone.example.",
  "*.net1.zone.example. 60 edge A",
  "*.net1.zone.example. 60 edge AAAA",
  "www.net1.zone.example. 300 user A 11.22.33.44",
  "www.net1.zone.example. 300 user AAAA 2a0f:ffff::7",
  "alias.net1.zone.example. 300 user CNAME www.net1.zone.example.",
  "dangling.net1.zone.example. 300 user CNAME gone.www.net1.zone.example.",
  "_sip._tcp.blog.net1.zone.example. 300 user SRV 10 5 5060 sip.other.example.",
  "blog.net1.zone.example. 0 copy",
  "_tcp.blog.net1.zone.example. 0 copy",
  "_xmpp._tcp.chat.net1.zone.example. 300 user SRV 10 5 5222 chat.other.example."
 ],
 "healthy": {"edge": ["192.0.2.10", "2001:db8::10"], "router": []},
 "cases": [
  {
   "name": "a name that does not exist stays NXDOMAIN without DO",
   "query": "nosuch.zone.example. A",
   "do": false,
   "rcode": "NXDOMAIN",
   "authority": ["zone.example. 60 IN SOA ns1.zone.example. hostmaster.zone.example. 100 7200 3600 1209600 60"]
  },
  {
   "name": "under DO it is NOERROR with an NSEC at that name and nothing walkable",
   "query": "nosuch.zone.example. A",
   "rcode": "NOERROR",
   "authority": [
    "zone.example. 60 IN SOA ns1.zone.example. hostmaster.zone.example. 100 7200 3600 1209600 60",
    "nosuch.zone.example. 60 IN NSEC \\000.nosuch.zone.example. RRSIG NSEC NXNAME"
   ],
   "rrsigs": ["zone.example. SOA 2", "nosuch.zone.example. NSEC 3"]
  },
  {
   "name": "CO restores the NXDOMAIN rcode, the denial unchanged",
   "query": "nosuch.zone.example. A",
   "co": true,
   "rcode": "NXDOMAIN",
   "co_echo": true,
   "authority": [
    "zone.example. 60 IN SOA ns1.zone.example. hostmaster.zone.example. 100 7200 3600 1209600 60",
    "nosuch.zone.example. 60 IN NSEC \\000.nosuch.zone.example. RRSIG NSEC NXNAME"
   ],
   "rrsigs": ["zone.example. SOA 2", "nosuch.zone.example. NSEC 3"]
  },
  {
   "name": "a name under an owner that blocks the wildcard",
   "query": "x.www.net1.zone.example. AAAA",
   "rcode": "NOERROR",
   "authority": [
    "zone.example. 60 IN SOA ns1.zone.example. hostmaster.zone.example. 100 7200 3600 1209600 60",
    "x.www.net1.zone.example. 60 IN NSEC \\000.x.www.net1.zone.example. RRSIG NSEC NXNAME"
